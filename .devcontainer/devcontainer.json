{
  "name": "Topside Dev Container",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/ws_ros/src/topside,type=bind",
  "workspaceFolder": "/home/ubuntu/ws_ros/src/topside",
  "remoteUser": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../",
    "options": ["--ssh=default"]
  },
  "runArgs": [
    "--network=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp:unconfined",
    "--security-opt=apparmor:unconfined",
    "--volume=/dev:/dev",
    "--privileged",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
    "--gpus=all,capabilities=video",
    "--runtime=nvidia"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1",
    "QT_QPA_PLATFORM": "xcb",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all"
  }
}
